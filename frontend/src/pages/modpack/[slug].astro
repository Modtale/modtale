---
import { HTML_CACHE, setPublicHtmlCache, setNoStore } from '@/utils/htmlCache';
import { fetchPublicJson, isProjectData, isPublicProject } from '@/utils/publicSsr';
import BaseLayout from '../../layouts/BaseLayout.astro';
import App from '../../App';
import { SiteRoutes } from '../../utils/routes';
import { generateProjectMeta } from '../../utils/meta';
import { ROUTE_SEO } from '../../data/seo-constants';
import {
    generateOrganizationSchema,
    generateProjectSchemas,
    generateWebsiteSchema,
    getProjectOgImageUrl,
} from '../../utils/schema';
import { BACKEND_URL, SERVER_BACKEND_URL } from "@/utils/api.ts";

const { slug } = Astro.params;
const path = Astro.url.pathname;
const cleanPath = path.replace(/\/$/, "");
const projectId = slug ? SiteRoutes.extractId(slug) : '';

let modData = null;
let projectUnavailableStatus = 0;
let robots = 'index,follow';
let title = ROUTE_SEO['/modpacks'].title;
let description = ROUTE_SEO['/modpacks'].description;
let image = getProjectOgImageUrl(projectId);
let jsonLd: any = undefined;
let ssrSuccessfullyCompleted = false;

if (projectId) {
    try {
        const result = await fetchPublicJson(`${SERVER_BACKEND_URL}/api/v1/projects/${encodeURIComponent(projectId)}`, 2500);
        if (isProjectData(result.data)) {
            modData = result.data;

            const canonicalUrl = SiteRoutes.project(modData);
            if (cleanPath !== canonicalUrl.replace(/\/$/, "")) {
                return Astro.redirect(canonicalUrl, 301);
            }

            const meta = generateProjectMeta(modData);
            if (meta) {
                title = meta.title;
                description = meta.description;
            }

            jsonLd = [
                generateWebsiteSchema(),
                generateOrganizationSchema(),
                ...generateProjectSchemas(modData),
            ];
            ssrSuccessfullyCompleted = isPublicProject(modData);
            if (!ssrSuccessfullyCompleted) robots = 'noindex,follow';
        } else if (result.status === 404 || result.status === 410) {
            projectUnavailableStatus = result.status;
        }
    } catch (e) {
        projectUnavailableStatus = 0;
    }
}

if (projectUnavailableStatus) {
    Astro.response.status = projectUnavailableStatus;
    robots = 'noindex,follow';
    title = 'Project unavailable | Modtale';
    description = 'This project is no longer available on Modtale.';
}
if (ssrSuccessfullyCompleted) {
    setPublicHtmlCache(Astro.response.headers, HTML_CACHE.content);
} else {
    setNoStore(Astro.response.headers);
}

const projectInitialData = modData || (projectUnavailableStatus && projectId ? { __projectUnavailable: true, id: projectId } : null);
const projectBootstrapUrl = !projectInitialData && projectId ? `${BACKEND_URL}/api/v1/projects/${projectId}` : undefined;
---

<BaseLayout title={title} description={description} image={image} jsonLd={jsonLd} initialData={projectInitialData} projectBootstrapUrl={projectBootstrapUrl} robots={robots}>
    <App client:load initialPath={path} ssrData={projectInitialData} />
</BaseLayout>
