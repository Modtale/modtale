---
import BaseLayout from '../../layouts/BaseLayout.astro';
import App from '../../App';
import { HTML_CACHE, setPublicHtmlCache, setNoStore } from '@/utils/htmlCache';
import { fetchPublicJson } from '@/utils/publicSsr.server';
import { generateUserMeta } from '../../utils/meta';
import { ROUTE_SEO } from '../../data/seo-constants';
import { SERVER_BACKEND_URL } from "@/utils/api.ts";
import { SiteRoutes } from '../../utils/routes';

const { username: handle } = Astro.params;
const path = Astro.url.pathname;


let userData = null;
let title = ROUTE_SEO['/mods'].title;
let description = ROUTE_SEO['/mods'].description;
let image = 'https://modtale.net/assets/logo.svg';
let jsonLd: any = undefined;
let ssrSuccessfullyCompleted = false;
let ogType = "website";
let robots = 'index,follow';

if (handle) {
    try {
        const result = await fetchPublicJson(`${SERVER_BACKEND_URL}/api/v1/user/profile/${encodeURIComponent(handle)}`, 2500);

        if (result.data && typeof result.data.id === 'string' && typeof result.data.username === 'string') {
            userData = result.data;
            
            const meta = generateUserMeta(userData);
            if (meta) {
                title = meta.title;
                description = meta.description;
            }

            if (userData.avatarUrl) {
                image = userData.avatarUrl;
            }
            
            ogType = userData.accountType === 'ORGANIZATION' ? 'website' : 'profile';

            const canonicalPath = SiteRoutes.creator(userData.id, userData.username);
            if (path.replace(/\/$/, "") !== canonicalPath.replace(/\/$/, "")) {
                return Astro.redirect(canonicalPath, 301);
            }

            const personSchema = {
                "@context": "https://schema.org",
                "@type": userData.accountType === 'ORGANIZATION' ? 'Organization' : 'Person',
                "name": userData.displayName || userData.username,
                "description": userData.bio,
                "image": userData.avatarUrl,
                "url": `https://modtale.net${canonicalPath}`
            };

            jsonLd = [personSchema];
            ssrSuccessfullyCompleted = true;
        } else if (result.status === 404 || result.status === 410) {
            Astro.response.status = result.status;
            robots = 'noindex,follow';
            title = 'Creator unavailable | Modtale';
            description = 'This creator profile is no longer available on Modtale.';
        }
    } catch (e) {}
}

if (ssrSuccessfullyCompleted) {
    setPublicHtmlCache(Astro.response.headers, HTML_CACHE.content);
} else {
    setNoStore(Astro.response.headers);
}
---

<BaseLayout title={title} description={description} image={image} jsonLd={jsonLd} initialData={userData} ogType={ogType} robots={robots}>
    <App client:load initialPath={path} ssrData={userData} />
</BaseLayout>
